rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{document=**} {
      allow read: if request.auth != null && request.auth.token.email == 'ayush.bhujle@gmail.com';
      allow write: if request.auth != null && request.auth.token.email == 'ayush.bhujle@gmail.com' && (resource == null || resource.data.get('denyAdminWrites', false) != true);
    }
    match /userDirectory/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && getAfter(/databases/$(database)/documents/users/$(uid)).data.get('denyWrites', false) != true;
    }
    // DM fixtures: directory lookups, participant-only threads, atomic reference creation.
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid != userId;
      allow list: if request.auth != null && request.query.limit <= 1;
    }
    match /directMessages/{conversationId} {
      allow read: if request.auth != null && (!exists(/databases/$(database)/documents/directMessages/$(conversationId)) || request.auth.uid in resource.data.participants);
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants && request.resource.data.participants.size() == 2;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants && request.resource.data.participants == resource.data.participants;
      match /messages/{messageId} {
        allow read, create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(conversationId)).data.participants;
      }
    }
    match /users/{userId}/dmConversations/{conversationId} {
      allow create, update: if request.auth != null && request.auth.uid in getAfter(/databases/$(database)/documents/directMessages/$(conversationId)).data.participants && userId in getAfter(/databases/$(database)/documents/directMessages/$(conversationId)).data.participants;
    }
    match /users/{userId}/notifications/{notificationId} {
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(request.resource.data.conversationId)).data.participants && userId in get(/databases/$(database)/documents/directMessages/$(request.resource.data.conversationId)).data.participants;
    }
    // Local emulator fixture only; never deploy these as production rules.
    match /users/{userId}/{document=**} {
      function ownsProfile() { return request.auth != null && request.auth.uid == userId; }
      function blocked(flag) {
        return exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.get(flag, false) == true;
      }
      allow read: if ownsProfile() && !blocked('denyReads');
      allow write: if ownsProfile() && !blocked('denyWrites');
    }
  }
}
